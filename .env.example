# Craffé — environment template. Copy to .env.local and fill in.

# Gemini API key for the "Ask Craffé" chatbot. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase (optional — the app runs on an in-memory demo store when these are blank).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
