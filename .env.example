# Craffé — environment template. Copy to .env.local and fill in.

# "Ask Craffé" chatbot. Claude is the primary model; Gemini takes over when Claude
# is out of credits or down. Set at least one.
# Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase. Required — orders, staff accounts and live updates all run on it.
# Apply supabase/migrations/*.sql in order to a fresh project first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security entirely, so orders can be written on
# behalf of anonymous customers. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
